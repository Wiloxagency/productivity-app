# Database Configuration
# Replace with your actual MongoDB connection string
# For MongoDB Atlas: Use the connection string from your cluster's "Connect" button
# For local MongoDB: Use mongodb://localhost:27017/your-database-name
MONGODB_URI=mongodb://localhost:27017/productivity-app

# Server Configuration
PORT=5001

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Environment
NODE_ENV=development

# AI assistant (chat desplegable)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-6-astra
# Optional
# OPENAI_API_MODE=responses   # responses (default, needed by gpt-6-astra) | chat
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low
# OPENAI_TIMEOUT_MS=60000
# ASSISTANT_RATE_LIMIT_PER_MIN=15
